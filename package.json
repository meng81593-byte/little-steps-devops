  "description": "Help the puppy navigate energy games!",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.12.0",
    "expose-loader": "^5.0.1",
    "globals": "^17.13.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "webpack --mode production",
    "lint": "eslint . --max-warnings=0",
